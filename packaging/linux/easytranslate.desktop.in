[Desktop Entry]
Version=1.0
Type=Application
Name=EasyTranslate
Comment=Lightweight instant translation tool
Exec=env -u ELECTRON_RUN_AS_NODE @APP_ROOT@/node_modules/.bin/electron @APP_ROOT@ --show
TryExec=@APP_ROOT@/node_modules/.bin/electron
Icon=@ICON_PATH@
Terminal=false
Categories=Utility;
Keywords=translate;translation;dictionary;
StartupWMClass=EasyTranslate
